# Cloudflare Pages response headers. Consumed at deploy time, never served.
# https://developers.cloudflare.com/pages/configuration/headers/

# The manifest is the one mutable file in the gallery: re-running
# encrypt-photos.mjs produces a new salt, so a stale manifest paired with fresh
# blobs decrypts to nothing. viewer.js already fetches it with cache: "no-store",
# but that only bypasses the browser cache -- this rule keeps Cloudflare's edge
# from holding onto it too. Must stay above /photos/* to win the overlap.
/photos/manifest.json
  Cache-Control: no-store

# Blobs are immutable by construction: every URL carries ?v=<buildId> (see
# withBuild() in js/viewer.js), so a new build never reuses an old URL.
/photos/*
  Cache-Control: public, max-age=31536000, immutable
